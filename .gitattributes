# Normalize line endings of text files to LF
* text=auto eol=lf

# Normalize line endings of Windows text files to CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ahk text eol=crlf

# Mark common binary files as not text
*.sqlite3 -text -diff
*.jpg -text -diff
*.jpeg -text -diff
*.avif -text -diff
*.png -text -diff
